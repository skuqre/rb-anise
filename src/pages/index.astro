---
import "../css/styles.css";

const anisRequest = await ( await fetch("https://api.dotgg.gg/nikke/character/anis") ).json();
const anisSkill1 = anisRequest.skills[0].description.replaceAll(/<[^>]*>/g, "").replaceAll( /{(.*?)}/g, "<b>x</b>") + "<br><br>";
const anisSkill2 = anisRequest.skills[1].description.replaceAll(/<[^>]*>/g, "").replaceAll( /{(.*?)}/g, "<b>x</b>") + "<br><br>";
const anisBurst = anisRequest.skills[2].description.replaceAll(/<[^>]*>/g, "").replaceAll( /{(.*?)}/g, "<b>x</b>");
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Rebuild Anisé</title>
        <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
        <link rel="shortcut icon" href="https://cdn.discordapp.com/emojis/1240673618917326978.png" type="image/png">
    </head>
    <body>
        <div style="text-align: center;">
            <h1>Rebuild Anisé</h1>
            <p>
                A NIKKE Discord Bot that provides you with (almost) everything you need.<br>
                This place just stores the needed pages for some features.
            </p>
            <br>
            <p style="font-style: normal;"><a href="/rb-anise/tos">Terms of Service</a> &bull; <a href="/rb-anise/privacy">Privacy Policy</a> &bull; <a href="/rb-anise/ai-rules/">AI Rules</a></p>
        </div>
    </body>
</html>
